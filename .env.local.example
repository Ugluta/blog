# =============================================================================
# KURUMSAL — Yerel Kurulum .env Dosyası
# =============================================================================
# Bu dosyayı kopyalayıp adını ".env" yapın: cp .env.local.example .env
# [ZORUNLU] = Doldurulmadan site açılmaz
# [İSTEĞE BAĞLI] = Boş bırakılırsa o özellik çalışmaz, site açılır
# [OTO] = Komutla üretin, elle yazmayın
# =============================================================================


# ─── VERİTABANI [ZORUNLU] ────────────────────────────────────────────────────
# PostgreSQL bağlantı adresi.
# Windows'ta PostgreSQL kurduktan sonra:
#   1. pgAdmin aç → yeni bir "kurumsal" database oluştur
#   2. Kullanıcı adı genelde "postgres", şifre kurulumda belirlediğiniz
DATABASE_URL="postgresql://postgres:SIFRENIZ@localhost:5432/kurumsal?schema=public"


# ─── NEXTAUTH [ZORUNLU] ──────────────────────────────────────────────────────
# [OTO] Secret üretmek için PowerShell'de çalıştırın:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Çıktıyı aşağıya yapıştırın (tırnak içinde kalmalı)
NEXTAUTH_SECRET="BURAYA-URETILEN-RASTGELE-DEGERI-YAPISTIRINIZ"
NEXTAUTH_URL="http://localhost:3000"


# ─── ADMIN HESABI [ZORUNLU] ──────────────────────────────────────────────────
# "npm run db:seed" komutu bu bilgilerle admin hesabı oluşturur.
# Gerçek bir e-posta yazın — sonradan değiştirebilirsiniz.
SEED_ADMIN_EMAIL="siz@email.com"
SEED_ADMIN_PASSWORD="GucluBirSifre123!"


# ─── REDIS [ZORUNLU — Scraper kullanacaksanız] ───────────────────────────────
# Windows için Redis kurulumu:
#   https://github.com/tporadowski/redis/releases → Redis-x64-xxx.msi indir ve kur
#   Kurulumdan sonra servis otomatik başlar.
# Scraper kullanmayacaksanız bu satırı olduğu gibi bırakın.
REDIS_URL="redis://localhost:6379"


# ─── ANTHROPIC (Claude AI) [İSTEĞE BAĞLI] ───────────────────────────────────
# Scraper'ın AI ile içerik üretmesi için gerekli.
# https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=""


# ─── OPENAI [İSTEĞE BAĞLI] ───────────────────────────────────────────────────
# Alternatif AI özellikler için.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""


# ─── GOOGLE GEMINI [İSTEĞE BAĞLI] ────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""


# ─── E-POSTA / SMTP [İSTEĞE BAĞLI] ──────────────────────────────────────────
# Ekip davetleri ve bülten gönderimi için.
# Gmail kullanacaksanız:
#   1. Google Hesabım → Güvenlik → 2 adımlı doğrulamayı aç
#   2. Uygulama Şifreleri → "Posta" için yeni şifre oluştur (16 karakter)
#   3. O 16 karakteri SMTP_PASS'a yazın (boşluklar olmadan)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="gmail-adresiniz@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="gmail-adresiniz@gmail.com"
SMTP_FROM_NAME="KURUMSAL"


# ─── STRIPE (Ödeme) [İSTEĞE BAĞLI] ──────────────────────────────────────────
# Fiyatlandırma sayfası ve abonelik için.
# https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


# ─── SOSYAL MEDYA OAUTH [İSTEĞE BAĞLI] ──────────────────────────────────────
# Sosyal hesap bağlama özelliği için. Her platform için ayrı app oluşturmanız gerekir.

# Twitter/X: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Facebook: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google (giriş için): https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TikTok: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""


# ─── DOSYA DEPOLAMA S3/R2 [İSTEĞE BAĞLI] ────────────────────────────────────
# Görsel/video yükleme için. Cloudflare R2 (ücretsiz 10GB) önerilir:
# https://dash.cloudflare.com → R2 → Create Bucket
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""


# ─── AWS POLLY (Sesli okuma) [İSTEĞE BAĞLI] ─────────────────────────────────
# Metinden ses üretimi için.
# https://console.aws.amazon.com → IAM → Kullanıcı oluştur → Polly yetkisi ver
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
