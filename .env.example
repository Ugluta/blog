# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.
# .env asla git'e commit edilmez (.gitignore içinde).

# --- Veritabanı ---
# prisma.config.ts kullanıldığı için migration yerine `npm run db:push` kullanılır.
DATABASE_URL="postgresql://blog:CHANGE_ME@localhost:5432/blog?schema=public"

# --- Redis / BullMQ (worker.ts için) ---
REDIS_URL="redis://127.0.0.1:6379"

# --- AI (scraper sonrası içerik revizyonu) ---
ANTHROPIC_API_KEY="sk-ant-CHANGE_ME"
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Oturum / admin girişi ---
# Rastgele uzun bir değer üretin: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_RANDOM_LONG_STRING"

# Sadece `npm run db:seed` ilk admin kullanıcıyı oluştururken kullanılır.
ADMIN_EMAIL="admin@kurumsal.com"
ADMIN_PASSWORD="CHANGE_ME"

# --- Worker döngü aralıkları (ms, opsiyonel) ---
SCRAPE_INTERVAL_MS=900000
REVISE_INTERVAL_MS=300000
PUBLISH_INTERVAL_MS=600000

NODE_ENV=production
