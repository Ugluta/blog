generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  MODERATOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  moderated    ContentItem[] @relation("Moderator")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sources   Source[]
  items     ContentItem[]
  createdAt DateTime   @default(now())
}

enum SourceType {
  RSS
  HTML
}

model Source {
  id            String     @id @default(cuid())
  name         String
  url          String
  type         SourceType @default(RSS)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  active       Boolean    @default(true)
  htmlSelector String?
  lastScrapedAt DateTime?
  items        ContentItem[]
  createdAt    DateTime   @default(now())
}

enum ContentStatus {
  SCRAPED
  REVISING
  IN_REVIEW
  PUBLISHED
  REJECTED
  FAILED
}

model ContentItem {
  id            String        @id @default(cuid())
  sourceId      String?
  source        Source?       @relation(fields: [sourceId], references: [id])
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  sourceUrl     String        @unique
  rawTitle      String
  rawContent    String
  aiTitle       String?
  aiContent     String?
  slug          String?       @unique
  status        ContentStatus @default(SCRAPED)
  failureReason String?
  moderatedById String?
  moderatedBy   User?         @relation("Moderator", fields: [moderatedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SocialAccount {
  id              String   @id @default(cuid())
  platform        String
  label           String?
  credentialsJson String?
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
